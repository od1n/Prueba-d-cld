<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SistemaGestion.Api</RootNamespace>
    <NoWarn>CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- DPAPI (ProtectedData) — sólo funciona en Windows pero el ensamblado
         debe estar referenciado para compilar en net8.0 puro. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Redimensionado de imágenes de referencia (pura .NET, soporta webp). -->
    <!-- ImageSharp fijado en 3.1.12 (ultima 3.x). Los avisos de seguridad se
         corrigen recien en 4.1.2, pero la 4.x exige una clave de licencia de
         Six Labors para compilar. Uso real: solo RedimensionarJpeg en
         ContenidoEndpoints (PNG/JPEG/WebP -> JPEG). Analisis de exposicion:
         - GHSA-j3p4-wp97-rph4 (HistogramEqualization): no se usa.
         - GHSA-j9gm-c75j-xc9q / GHSA-jjfr-hcj7-qf5w (codificador TIFF CCITT): no se codifica TIFF.
         - GHSA-wmxv-xphr-5c9g (BigTIFF) y GHSA-gwg2-r3hj-4w44 (perfil ICC):
           mitigados con DecoderOptions (solo PNG/JPEG/WebP, SkipMetadata). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Avisos de ImageSharp revisados y mitigados (ver comentario arriba).
       Al pasar a ImageSharp 4.1.2 o superior, borrar este bloque. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

</Project>
