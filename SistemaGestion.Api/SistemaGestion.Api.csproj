<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SistemaGestion.Api</RootNamespace>
    <NoWarn>CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- DPAPI (ProtectedData) — sólo funciona en Windows pero el ensamblado
         debe estar referenciado para compilar en net8.0 puro. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Redimensionado de imágenes de referencia (PNG/JPEG/WebP -> JPEG) en
         ContenidoEndpoints.RedimensionarJpeg. SkiaSharp (licencia MIT) reemplaza a
         SixLabors.ImageSharp: la 3.x tiene avisos de seguridad sin corrección y la
         4.x no compila en Release sin una clave de licencia de Six Labors. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <!-- Biblioteca nativa de SkiaSharp para Linux: solo para compilar y probar fuera
       de Windows. En Windows (OLIMPO, SERVO) no se usa. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <!-- Regla común de cédula/RIF de clientes (mismo archivo que la app de escritorio). -->
  <ItemGroup>
    <Compile Include="..\ClienteDocumento.cs" Link="Compartido\ClienteDocumento.cs" />
  </ItemGroup>

</Project>
