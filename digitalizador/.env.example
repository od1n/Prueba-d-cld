# ── Backend de visión ─────────────────────────────────────────────────
# Opciones: ollama | groq | anthropic
VISION_BACKEND=ollama

# ── Groq (https://console.groq.com → API Keys → Create) ──────────────
# Modelo recomendado: llama-3.2-11b-vision-preview (gratis, ~2-4 seg)
# También disponible: llama-3.2-90b-vision-preview (más lento, más preciso)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.2-11b-vision-preview

# ── Anthropic (https://console.anthropic.com → API Keys) ─────────────
# Modelo recomendado: claude-haiku-4-5 (rápido y barato)
# Mejor calidad:      claude-sonnet-4-6 (más lento, mucho más preciso)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Ollama local (default) ────────────────────────────────────────────
# Modelos vision recomendados:
#   gemma4:31b-cloud   → multimodal, rápido vía Ollama Cloud (recomendado)
#   llama3.2-vision    → multimodal local (requiere GPU potente)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# ── Base de datos (opcional) ──────────────────────────────────────────
# Por defecto apunta a %AppData%\SistemaGestion\sistema_gestion.db
# Descomentar solo si la BD está en otra ubicación:
# DB_PATH=C:\ruta\personalizada\sistema_gestion.db
