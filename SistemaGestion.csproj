<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SistemaGestion</AssemblyName>
    <RootNamespace>SistemaGestion</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Descifrar\**" />
    <None Remove="Descifrar\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.7.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.3.4" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!-- Excluir subproyectos que comparten la carpeta raíz.
       Sin esto, el SDK glob incluye sus .cs y obj/ autogenerados en este build
       causando CS0579 (atributos duplicados) y CS0246 (referencias faltantes). -->
  <ItemGroup>
    <Compile Remove="SistemaGestion.Api\**" />
    <Content Remove="SistemaGestion.Api\**" />
    <EmbeddedResource Remove="SistemaGestion.Api\**" />
    <None Remove="SistemaGestion.Api\**" />

    <Compile Remove="SistemaGestion.Api.Tests\**" />
    <Content Remove="SistemaGestion.Api.Tests\**" />
    <EmbeddedResource Remove="SistemaGestion.Api.Tests\**" />
    <None Remove="SistemaGestion.Api.Tests\**" />

    <Compile Remove="Scripts\InsertarPrueba\**" />
    <Compile Remove="winforms-patterns\**" />
  </ItemGroup>

</Project>
