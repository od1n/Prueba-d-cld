# ── Copiar este archivo a .env y completar los valores ───────────────────────
# NUNCA subir .env a git (ya está en .gitignore)

# Token del bot de Telegram (obtener de @BotFather con /newbot)
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID numérico del chat del operador (obtener enviando un mensaje a @userinfobot)
OPERATOR_CHAT_ID=987654321

# API key de Google Gemini — GRATIS, sin restricciones regionales
# Obtener en https://aistudio.google.com → Get API key → Create API key
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo Gemini a usar (gemini-1.5-flash = más rápido/gratuito)
GEMINI_MODEL=gemini-1.5-flash

# Ajuste fino (opcional)
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# HISTORY_WINDOW=10
