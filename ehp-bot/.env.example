# ── Copiar a .env y completar. NUNCA subir .env a git (ya esta en .gitignore) ──

# Token del bot de Telegram (de @BotFather con /newbot)
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID de Telegram del operador que recibe aviso de pedidos (opcional; de @userinfobot)
OPERATOR_CHAT_ID=987654321

# ── SistemaGestion (mismos endpoints /api/wa/* que el bot de WhatsApp) ─────────
# Base del API por el tunel de Cloudflare (o IP local en la LAN, ej http://192.168.68.132:5443)
SG_API_URL=https://api-sg.hato-pascher.com

# Token interno: DEBE ser el MISMO SG_INTERNAL_TOKEN de la API / n8n / digitalizador
SG_INTERNAL_TOKEN=pega-aqui-el-mismo-token-interno

# Timeout de las llamadas HTTP en segundos (opcional)
# SG_TIMEOUT=12
